PORT=9877
OLLAMA_BASE=http://127.0.0.1:11434

# Primary translation model. Any ollama model works (local or -cloud):
# the system prompt is sent with every request, so no Modelfile is needed.
OLLAMA_MODEL=gemma4:cloud

# Local fallback model, used when the primary model fails
# (e.g. cloud quota exhausted). Must differ from the primary to take effect.
OLLAMA_FALLBACK_MODEL=gemma2:2b
